APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Google Search Console — isi token dari Search Console > Verifikasi kepemilikan
# GOOGLE_SITE_VERIFICATION=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Laravel Reverb (WebSocket Real-Time) ──────────────────────────────
# Generate credentials via: php artisan reverb:install
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ── Reverb SERVER (alamat daemon Reverb listen — bind internal VPS)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ── Reverb CLIENT PUBLIC (alamat diakses BROWSER client)
# ── PRODUCTION (default — via Nginx reverse proxy di port 443/HTTPS) ──
REVERB_HOST="kasirumkm.web.id"   # domain production (JANGAN "localhost")
REVERB_PORT=                     # KOSONGKAN → otomatis pakai port halaman (443)
REVERB_SCHEME=https              # HTTPS = wss://
#
# --- LOKAL (dev: php artisan reverb:start + vite dev) ---
# REVERB_HOST="localhost"
# REVERB_PORT=8080
# REVERB_SCHEME=http
#
# Catatan:
# - Jika REVERB_HOST dikosongkan / "localhost" / "127.0.0.1" di browser
#   client, maka otomatis pakai window.location.hostname (domain halaman saat ini).
# - REVERB_PORT + VITE_REVERB_PORT KOSONGKAN jika pakai reverse proxy
#   (Nginx/Caddy handle WSS di 443, lalu proxy_pass internal ke 127.0.0.1:8080).

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── AI Assistant (Asisten AI "Macca") ─────────────────────────────────
# Konfigurasi AI utama disimpan di database (tabel ai_configurations) per toko.
# Variabel di bawah hanya untuk fallback / default jika belum ada konfigurasi DB.
# Batas waktu tunggu respons AI — kecilkan jika provider lambat, besarkan jika model butuh penalaran panjang.
# AI_TIMEOUT=45

# --- Push peringatan proaktif (keluar aplikasi) ---
# In-app (AiAlert + WebSocket) selalu aktif. Channel berikut opsional & bisa nyala terpisah.
# ALERT_PUSH_ENABLED=true
# ALERT_PUSH_MAIL_ENABLED=true
# EMAIL_FROM=owner@umkm-kasir.test
# EMAIL_FROM_NAME="${APP_NAME}"
# ALERT_PUSH_TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=
# ALERT_PUSH_WHATSAPP_ENABLED=false
# WHATSAPP_GATEWAY_URL=http://localhost:3000
# WHATSAPP_WEBHOOK_URL=http://localhost:3000
# WHATSAPP_TOKEN=
# WHATSAPP_TIMEOUT=10
# WHATSAPP_RECIPIENTS=62812xxxxxxx,62813xxxxxxx
# ALERT_WHATSAPP_RECIPIENTS=62812xxxxxxx
# Ambang deteksi margin turun (poin persentase / persen relatif / jendela hari)
# ALERT_MARGIN_DROP_POINTS=5
# ALERT_MARGIN_DROP_PERCENT=15
# ALERT_MARGIN_WINDOW_DAYS=7

# Provider AI spesifik (override fallback ke config/ai.php jika masih kosong di DB).
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=gpt-4o-mini
# AI_DEFAULT_API_KEY=
# AI_DEFAULT_BASE_URL=
