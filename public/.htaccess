<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X_XSRF_TOKEN}]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Force PHP 8.3 and enable extensions
<IfModule mod_php.c>
    php_value mbstring.func_overload 0
    php_value mbstring.internal_encoding UTF-8
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
</IfModule>

# Alternative PHP handler
AddHandler application/x-httpd-php83 .php

# Security Headers untuk HTTPS
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ===== CACHE HEADERS for Performance =====
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images - 1 year cache
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS & JS - 1 month cache
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # Fonts - 1 year cache
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/x-font-otf "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # HTML - no cache (always check for updates)
    ExpiresByType text/html "access plus 0 seconds"
    
    # Default - 1 week
    ExpiresDefault "access plus 1 week"
</IfModule>

# ===== CACHE-CONTROL FALLBACK =====
# mod_expires di atas hanya aktif jika mod_expires tersedia. Di server
# tanpa mod_expires, TTL tidak dikirim sehingga Lighthouse menilai
# "Use efficient cache durations" sebagai masalah. Header Cache-Control
# di bawah tetap bekerja via mod_headers yang hampir selalu tersedia.
<IfModule mod_headers.c>
    # Gambar - 1 tahun
    <FilesMatch "\.(?:jpe?g|png|gif|webp|svg|ico|bmp|avif)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # Font - 1 tahun
    <FilesMatch "\.(?:woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # CSS & JS - 1 bulan (Vite hash file tetap aman)
    <FilesMatch "\.(?:css|js|map)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # HTML - selalu revalidasi (pastikan tidak di-cache client)
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ===== COMPRESS TEXT ASSETS =====
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject application/x-font-ttf application/x-font-otf font/opentype font/ttf font/otf
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE application/x-font-woff
    AddOutputFilterByType DEFLATE application/x-font-woff2
</IfModule>
